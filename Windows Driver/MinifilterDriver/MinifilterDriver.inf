;
; MinifilterDriver.inf
;

[Version]
Signature   = "$WINDOWS NT$"
Class       = "ActivityMonitor"                         ; Thuộc nhóm Activity Monitor
ClassGuid   = {b4c3db5e-7011-4456-91a7-b44cbf107201}    ; GUID chuẩn của FSFilter Activity Monitor
Provider    = %ManufacturerName%
DriverVer   = 
CatalogFile = MinifilterDriver.cat
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir          = 12
Minifilter.DriverFiles  = 12            ; %windir%\system32\drivers

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
MinifilterDriver.sys = 1,,

[DefaultInstall.NT$ARCH$]
OptionDesc          = %ServiceDescription%
CopyFiles           = Minifilter.DriverFiles

[DefaultInstall.NT$ARCH$.Services]
AddService          = %ServiceName%,,Minifilter.Service

[Minifilter.Service]
DisplayName      = %ServiceName%
Description      = %ServiceDescription%
ServiceBinary    = %12%\%DriverName%.sys        ; %windir%\system32\drivers\MinifilterDriver.sys
Dependencies     = "FltMgr"
ServiceType      = 2                            ; SERVICE_FILE_SYSTEM_DRIVER
StartType        = 3                            ; SERVICE_DEMAND_START
ErrorControl     = 1                            ; SERVICE_ERROR_NORMAL
LoadOrderGroup   = "FSFilter Activity Monitor"
AddReg           = Minifilter.AddRegistry

[Minifilter.AddRegistry]
HKR,,"DebugFlags",0x00010001 ,0x0
HKR,,"SupportedFeatures",0x00010001,0x3
HKR,"Instances","DefaultInstance",0x00000000,%DefaultInstance%
HKR,"Instances\"%Instance1.Name%,"Altitude",0x00000000,%Instance1.Altitude%
HKR,"Instances\"%Instance1.Name%,"Flags",0x00010001,%Instance1.Flags%

[Minifilter.DriverFiles]
%DriverName%.sys

[Strings]
ManufacturerName        = "CuongDev"
ServiceDescription     = "Minifilter File & Process Monitor Driver"
ServiceName            = "MinifilterDriver"
DriverName             = "MinifilterDriver"
DiskName               = "MinifilterDriver Source Disk"

DefaultInstance        = "MinifilterDriver - Top Instance"
Instance1.Name         = "MinifilterDriver - Top Instance"
Instance1.Altitude     = "370030"               ; Nhóm Activity Monitor (360000-389999)
Instance1.Flags        = 0x0
