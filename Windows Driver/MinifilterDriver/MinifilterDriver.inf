;
; MinifilterDriver.inf
;

[Version]
Signature   = "$WINDOWS NT$"
Class       = System ; TODO: specify appropriate Class
ClassGuid   = {4d36e97d-e325-11ce-bfc1-08002be10318} ; TODO: specify appropriate ClassGuid
Provider    = %ManufacturerName%
CatalogFile = MinifilterDriver.cat
DriverVer   = ; TODO: set DriverVer in stampinf property pages
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
MinifilterDriver.sys = 1,,

;*****************************************
; Install Section
;*****************************************

[Manufacturer]
%ManufacturerName% = Standard,NT$ARCH$.10.0...16299 ; %13% support introduced in build 16299

[Standard.NT$ARCH$.10.0...16299]
%MinifilterDriver.DeviceDesc% = MinifilterDriver_Device, Root\MinifilterDriver ; TODO: edit hw-id

[MinifilterDriver_Device.NT]
CopyFiles = File_Copy

[File_Copy]
MinifilterDriver.sys

;-------------- Service installation
[MinifilterDriver_Device.NT.Services]
AddService = MinifilterDriver,%SPSVCINST_ASSOCSERVICE%, MinifilterDriver_Service_Inst

; -------------- MinifilterDriver driver install sections
[MinifilterDriver_Service_Inst]
DisplayName    = %MinifilterDriver.SVCDESC%
ServiceType    = 1               ; SERVICE_KERNEL_DRIVER
StartType      = 3               ; SERVICE_DEMAND_START
ErrorControl   = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary  = %13%\MinifilterDriver.sys

[MinifilterDriver_Device.NT.Wdf]
KmdfService = MinifilterDriver, MinifilterDriver_wdfsect

[MinifilterDriver_wdfsect]
KmdfLibraryVersion = $KMDFVERSION$

[Strings]
SPSVCINST_ASSOCSERVICE = 0x00000002
ManufacturerName = "<Your manufacturer name>" ;TODO: Replace with your manufacturer name
DiskName = "MinifilterDriver Installation Disk"
MinifilterDriver.DeviceDesc = "MinifilterDriver Device"
MinifilterDriver.SVCDESC = "MinifilterDriver Service"
